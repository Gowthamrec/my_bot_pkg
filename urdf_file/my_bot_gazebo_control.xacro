<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo plugin for differential drive robot -->
    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

            <!-- Wheel Information -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.175</wheel_separation> <!-- Distance between the wheels -->
            <wheel_diameter>0.1</wheel_diameter>      <!-- Diameter of the wheels -->

            <!-- Limits for the wheels -->
            <max_wheel_torque>200</max_wheel_torque>          <!-- Max torque the wheels can handle -->
            <max_wheel_acceleration>10.0</max_wheel_acceleration> <!-- Max wheel acceleration -->

            <!-- Odometry output settings -->
            <odometry_frame>odom</odometry_frame>        <!-- Frame for odometry data -->
            <robot_base_frame>base_link</robot_base_frame> <!-- Base frame for the robot -->

            <!-- Publisher settings -->
            <publish_odom>true</publish_odom>              <!-- Publish odometry data -->
            <publish_odom_tf>true</publish_odom_tf>        <!-- Publish odometry TF -->
            <publish_wheel_tf>true</publish_wheel_tf>      <!-- Publish wheel TF -->

        </plugin>
    </gazebo>

</robot>
